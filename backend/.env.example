# Copie para .env e preencha com os valores locais
FLASK_APP=run.py
FLASK_DEBUG=1

# Chave usada na assinatura dos tokens JWT
SECRET_KEY=troque-esta-chave-em-producao

# Validade do token JWT em horas
TOKEN_HORAS=24

# Origens do frontend autorizadas (separadas por virgula)
CORS_ORIGENS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Conexao com o PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasko
